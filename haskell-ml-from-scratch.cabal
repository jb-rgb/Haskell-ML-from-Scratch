cabal-version:      2.4
name:               haskell-ml-from-scratch
version:            0.1.0.0
synopsis:           Pure functional implementation of MNIST classifiers
author:             Jorge Arturo Barahona de la Cruz
build-type:         Simple

library
    exposed-modules:  MathCore, DataLoader
    hs-source-dirs:   src
    build-depends:    base >= 4.7 && < 5
    default-language: Haskell2010

executable haskell-ml-from-scratch
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >= 4.7 && < 5,
                      haskell-ml-from-scratch
    default-language: Haskell2010

test-suite haskell-ml-from-scratch-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base >= 4.7 && < 5,
                      haskell-ml-from-scratch
    default-language: Haskell2010